{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hermes-engineering-bench/usage.schema.json",
  "title": "Hermes one-shot usage report (native fields, no normalized pricing)",
  "type": "object",
  "properties": {
    "estimated_cost_usd": {"type": ["number", "null"]},
    "cost_status": {"type": ["string", "null"]},
    "cost_source": {"type": ["string", "null"]},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "cache_read_tokens": {"type": ["integer", "null"], "minimum": 0},
    "cache_write_tokens": {"type": ["integer", "null"], "minimum": 0},
    "reasoning_tokens": {"type": ["integer", "null"], "minimum": 0},
    "total_tokens": {"type": ["integer", "null"], "minimum": 0},
    "api_calls": {"type": ["integer", "null"], "minimum": 0},
    "model": {"type": ["string", "null"]},
    "provider": {"type": ["string", "null"]},
    "session_id": {"type": ["string", "null"]},
    "completed": {"type": ["boolean", "null"]},
    "failed": {"type": "boolean"},
    "service_tier": {"type": ["string", "null"]},
    "failure": {"type": "string"},
    "wrapper_exit_status": {"type": "object"}
  },
  "additionalProperties": true
}
