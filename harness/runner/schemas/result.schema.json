{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hermes-engineering-bench/result.schema.json",
  "title": "Hermes benchmark result",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "model",
    "task",
    "outcome",
    "grader",
    "grader_parse_error",
    "usage_file",
    "exit_status_file",
    "timing_file"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "model": {
      "type": "object",
      "required": ["provider", "requested_id"],
      "properties": {
        "provider": {"enum": ["openai-codex", "opencode-go"]},
        "requested_id": {
          "enum": [
            "gpt-5.6-sol",
            "gpt-daybreak-blue-latest",
            "gpt-5.6-terra",
            "gpt-5.6-luna",
            "deepseek-v4-flash",
            "deepseek-v4-pro"
          ]
        }
      },
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "required": ["task_id", "attempt"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "attempt": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "outcome": {
      "type": "object",
      "required": ["success", "passed", "score", "hermes_completed", "grader_completed", "tool_sandbox_verified"],
      "properties": {
        "success": {"type": "boolean"},
        "passed": {"type": ["boolean", "null"]},
        "score": {"type": ["number", "null"]},
        "hermes_completed": {"type": "boolean"},
        "grader_completed": {"type": "boolean"},
        "tool_sandbox_verified": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "grader": {"type": ["object", "null"]},
    "grader_parse_error": {"type": ["string", "null"]},
    "usage_file": {"const": "usage.json"},
    "exit_status_file": {"const": "exit_status.json"},
    "timing_file": {"const": "timing.json"}
  },
  "additionalProperties": false
}
